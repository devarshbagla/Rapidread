{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rapidread-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rapidread",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
