{
  "name": "rapidread",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "BASE_PATH=/Rapidread/ npm run build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:dev": "mkdir -p dist && wrangler dev",
    "worker:deploy": "npm run build && wrangler deploy",
    "worker:d1:create": "wrangler d1 create rapidread --binding DB --update-config",
    "worker:d1:migrate": "wrangler d1 migrations apply rapidread --local",
    "worker:d1:migrate:remote": "wrangler d1 migrations apply rapidread --remote"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tabler/icons-react": "^3.35.0",
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.1.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.2"
  }
}
